# Copy this file to .env and fill in your real values. Never commit .env.

# ntfy.sh - pick a hard-to-guess topic name, e.g. "hutwatch-<random-string>"
NTFY_TOPIC=hutwatch-changeme

# SMTP (optional, only needed if "smtp" is in notifiers.enabled)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hutwatch@example.com
SMTP_TO=you@example.com
